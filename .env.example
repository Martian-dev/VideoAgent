# Copy to .env and fill in. This file overrides the ambient environment, so a
# stale global export of the same name cannot silently win.

# Meta Model API key -> https://ai.developer.meta.com/docs
META_AI_API_KEY=

# Optional overrides
# MONTAGE_MODEL=muse-spark-1.2-contributor   # 1.3 is not served in every region
# MONTAGE_WHISPER_MODEL=small.en             # base.en is 3x faster, less accurate
